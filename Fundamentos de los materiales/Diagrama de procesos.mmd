graph TB
    %% Definición de estilos
    classDef operacion fill:#6baed6,stroke:#08519c,stroke-width:2px,color:#000
    classDef inspeccion fill:#fdae6b,stroke:#e6550d,stroke-width:2px,color:#000
    classDef tramite fill:#ffeda0,stroke:#e31a1c,stroke-width:2px,color:#000
    classDef terminal fill:#d9d9d9,stroke:#666,stroke-width:2px,color:#000

    %% Nodos
    Inicio["Inicio: Recepción de materia prima"]
    Op1("1<br>Forja")
    Op2("2<br>Tratamiento térmico")
    Op3("3<br>Mecanizado")
    Insp1["1<br>Inspección (QC)"]
    Op4("4<br>Rectificado")
    Doc("Ø<br>Trazabilidad:<br>- Hoja de Ruta<br>- Código de parte<br>- Sello de QC<br>- Parámetros reales")
    Fin["Fin: Despacho del producto final"]

    %% Aplicar estilos
    class Inicio,Fin terminal
    class Op1,Op2,Op3,Op4 operacion
    class Insp1 inspeccion
    class Doc tramite

    %% Conexiones
    Inicio --> Op1
    Op1 --> Op2
    Op2 --> Op3
    Op3 --> Insp1
    Insp1 --> Op4
    Op4 --> Fin
    Doc --> Insp1