graph TD
    classDef inicioFin fill:#e0e0e0,stroke:#333,stroke-width:2px,color:black;
    classDef operacion fill:#6baed6,stroke:#333,stroke-width:2px,color:black,text-align:left;
    classDef inspeccion fill:#fdae6b,stroke:#333,stroke-width:2px,color:black,text-align:left;
    classDef trazabilidad fill:#fee391,stroke:#333,stroke-width:2px,color:black,text-align:left;

    Inicio["Inicio: Recepción de materia prima"]:::inicioFin --> A
    
    A(("<b>1. Forja</b><br>• Entradas: Material en bruto, energía térmica extrema.<br>• Variables: Presión de prensa, temp. de deformación.<br>• Salidas: Pieza preformada volumétricamente.")):::operacion --> B
    
    B(("<b>2. Tratamiento térmico</b><br>• Entradas: Energía térmica, gases de atmósfera controlada.<br>• Variables: Temp. crítica, tiempo de retención, tasa de enfriamiento.<br>• Salidas: Pieza con microestructura alterada (mayor dureza).")):::operacion --> C
    
    C(("<b>3. Mecanizado</b><br>• Entradas: Herramientas de corte, fluidos refrigerantes.<br>• Variables: Velocidad de corte, avance, RPM del husillo.<br>• Salidas: Pieza dimensionada, viruta metálica/scrap.")):::operacion --> D
    
    D["<b>1. Inspección (QC)</b><br>• Entradas: Pieza dimensionada, instrumentos de medición.<br>• Variables: Tolerancias de planos, rugosidad esperada.<br>• Salidas: Pieza aprobada, reporte de control."]:::inspeccion
    
    E(("<b>4. Rectificado</b><br>• Entradas: Muela abrasiva, emulsión refrigerante.<br>• Variables: Velocidad de la muela, avance micrométrico.<br>• Salidas: Pieza con acabado final, lodos abrasivos.")):::operacion
    
    Tz["<b>Ø Trazabilidad:</b><br>- Hoja de Ruta<br>- Código de parte<br>- Sello de QC<br>- Parámetros reales"]:::trazabilidad
    
    C --> D
    Tz --> D
    D --> E
    E --> Fin["Fin: Despacho del producto final"]:::inicioFin